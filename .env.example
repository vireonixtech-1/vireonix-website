# SMTP credentials used by src/pages/api/contact.ts to send the contact form email.
# Copy this file to .env and fill in real values. Never commit .env.
#
# Gmail example: host=smtp.gmail.com, port=587, secure=false, use a 16-char App Password
#   (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
# Custom domain mailbox (e.g. hr@vireonixtech.com) example: ask your host for its SMTP host/port.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hr@vireonixtech.com
SMTP_PASS=your-smtp-password-or-app-password

# Address the contact form email is sent FROM (often same as SMTP_USER)
CONTACT_FROM_EMAIL=hr@vireonixtech.com
# Address the contact form email is sent TO (where you want to receive inquiries)
CONTACT_TO_EMAIL=hr@vireonixtech.com
