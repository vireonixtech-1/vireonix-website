---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: 'guide-to-generative-ai-enterprise',
    title: 'The Complete Guide to Generative AI for Enterprise',
    description: 'Learn how generative AI is transforming business operations, from customer service automation to content generation and beyond.',
    category: 'Generative AI',
    author: 'Dr. Michael Roberts',
    date: '2025-01-08',
    readTime: '12 min',
    featured: true
  },
  {
    slug: 'cloud-migration-strategy-2025',
    title: 'Cloud Migration Strategy: A 2025 Playbook',
    description: 'A comprehensive guide to planning and executing successful cloud migrations with zero downtime and maximum ROI.',
    category: 'Cloud Migration',
    author: 'Priya Patel',
    date: '2025-01-05',
    readTime: '10 min',
    featured: true
  },
  {
    slug: 'react-vs-angular-2025',
    title: 'React vs Angular in 2025: Which Framework to Choose?',
    description: 'An in-depth comparison of React and Angular for enterprise web development, with recommendations based on project requirements.',
    category: 'Web Development',
    author: 'Arun Kumar',
    date: '2025-01-02',
    readTime: '8 min',
    featured: false
  },
  {
    slug: 'salesforce-implementation-best-practices',
    title: 'Salesforce Implementation Best Practices for 2025',
    description: 'Expert tips for successful Salesforce implementations, from planning and data migration to user adoption and optimization.',
    category: 'Salesforce',
    author: 'Jennifer Martinez',
    date: '2024-12-28',
    readTime: '9 min',
    featured: false
  },
  {
    slug: 'mobile-app-security-checklist',
    title: 'Mobile App Security Checklist: 15 Essential Measures',
    description: 'Protect your mobile application with this comprehensive security checklist covering authentication, data protection, and compliance.',
    category: 'Cybersecurity',
    author: 'David Chen',
    date: '2024-12-22',
    readTime: '7 min',
    featured: false
  },
  {
    slug: 'ux-design-trends-2025',
    title: 'UX Design Trends That Will Dominate 2025',
    description: 'From AI-powered personalization to immersive experiences, discover the UX design trends shaping digital products this year.',
    category: 'UI/UX Design',
    author: 'Sarah Williams',
    date: '2024-12-18',
    readTime: '6 min',
    featured: false
  }
];

const featuredPosts = posts.filter(p => p.featured);
const regularPosts = posts.filter(p => !p.featured);

const featuredTheme: Record<string, { badge: string; tile: string }> = {
  'Generative AI': { badge: 'bg-secondary/10 text-secondary', tile: 'from-purple-200 via-violet-200 to-indigo-300' },
  'Cloud Migration': { badge: 'bg-primary/10 text-primary', tile: 'from-blue-200 via-sky-200 to-indigo-300' },
};

const regularTheme: Record<string, { badge: string; tile: string; icon: string }> = {
  'Web Development': { badge: 'bg-blue-100 text-blue-700', tile: 'from-blue-100 to-blue-50', icon: 'text-blue-600' },
  Salesforce: { badge: 'bg-secondary/10 text-secondary', tile: 'from-purple-100 to-indigo-50', icon: 'text-secondary' },
  Cybersecurity: { badge: 'bg-rose-100 text-rose-700', tile: 'from-rose-100 to-rose-50', icon: 'text-rose-600' },
  'UI/UX Design': { badge: 'bg-emerald-100 text-emerald-700', tile: 'from-emerald-100 to-emerald-50', icon: 'text-emerald-600' },
};

function formatLong(date: string) {
  return new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
function formatShort(date: string) {
  return new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

// Blog page schema
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Vireonix Technologies Blog",
  "description": "Expert insights on web development, mobile apps, cloud migration, AI, and enterprise technology solutions.",
  "url": "https://vireonixtech.com/blog",
  "publisher": {
    "@type": "Organization",
    "name": "Vireonix Technologies LLC",
    "logo": {
      "@type": "ImageObject",
      "url": "https://vireonixtech.com/Untitled design.png"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://vireonixtech.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog"
    }
  ]
};
---

<Layout
  title="Blog | Technology Insights & Best Practices | Vireonix Technologies"
  description="Expert insights on web development, mobile apps, cloud migration, generative AI, Salesforce, and enterprise technology solutions from Vireonix Technologies."
>
  <Header />
  <main>
    <!-- Featured Posts -->
    <section class="pt-32 pb-20 bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-10">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span>/</span>
          <span class="text-gray-700">Blog</span>
        </nav>

        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-3 h-3 rounded-full bg-primary/20 flex items-center justify-center">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              </span>
              <span class="text-primary text-xs font-bold tracking-wider uppercase">Insights & Resources</span>
            </div>
            <h1 class="text-3xl md:text-4xl font-montserrat font-extrabold text-gray-900 mb-2">
              Featured Articles
            </h1>
            <p class="text-gray-500">Handpicked insights on AI, cloud, and digital transformation.</p>
          </div>
          <a href="/blog" class="inline-flex items-center gap-2 px-5 py-2.5 border border-primary/30 text-primary rounded-full font-semibold text-sm hover:bg-primary hover:text-white transition-colors duration-300 flex-shrink-0 self-start md:self-auto">
            View all articles
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>

        <!-- Featured Cards -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {featuredPosts.map(post => {
            const theme = featuredTheme[post.category];
            return (
              <a href={`/blog/${post.slug}`} class="group block bg-white border border-gray-100 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300">
                <div class={`relative h-64 bg-gradient-to-br ${theme.tile} flex items-center justify-center overflow-hidden`}>
                  <span class="absolute top-1/2 left-1/2 w-40 h-40 -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-white/50"></span>
                  <span class="absolute top-10 right-14 w-2 h-2 rounded-full bg-white/70"></span>
                  <span class="absolute bottom-14 left-16 w-1.5 h-1.5 rounded-full bg-white/60"></span>
                  {post.category === 'Generative AI' ? (
                    <svg class="relative w-28 h-28 drop-shadow-xl" viewBox="0 0 24 24" fill="none">
                      <ellipse cx="12" cy="21" rx="5" ry="1" fill="#312E81" fill-opacity="0.15"/>
                      <circle cx="8" cy="4.3" r="1.2" fill="#F472B6"/>
                      <rect x="7.5" y="5" width="1" height="2.2" fill="#F472B6"/>
                      <circle cx="16" cy="4.3" r="1.2" fill="#F472B6"/>
                      <rect x="15.5" y="5" width="1" height="2.2" fill="#F472B6"/>
                      <rect x="4.3" y="10.5" width="1.8" height="3" rx="0.9" fill="#F472B6"/>
                      <rect x="17.9" y="10.5" width="1.8" height="3" rx="0.9" fill="#F472B6"/>
                      <rect x="6" y="7.2" width="12" height="9" rx="4" fill="white"/>
                      <rect x="7.6" y="9.6" width="8.8" height="4" rx="2" fill="#1E1B4B"/>
                      <circle cx="10.2" cy="11.6" r="1" fill="#22D3EE"/>
                      <circle cx="13.8" cy="11.6" r="1" fill="#22D3EE"/>
                      <rect x="8.5" y="16.7" width="7" height="4.2" rx="2" fill="white"/>
                      <rect x="10.5" y="18.3" width="3" height="1.2" rx="0.6" fill="#4F46E5" fill-opacity="0.5"/>
                    </svg>
                  ) : (
                    <svg class="relative w-28 h-28 drop-shadow-xl" viewBox="0 0 24 24" fill="none">
                      <ellipse cx="12" cy="21.5" rx="7" ry="1" fill="#1E3A8A" fill-opacity="0.15"/>
                      <g fill="white" fill-opacity="0.7">
                        <rect x="2" y="14.5" width="3" height="6" rx="0.6"/>
                        <rect x="19" y="13" width="3" height="7.5" rx="0.6"/>
                      </g>
                      <g stroke="#1E3A8A" stroke-opacity="0.25" stroke-width="0.5" stroke-linecap="round">
                        <line x1="2.6" y1="16" x2="4.4" y2="16"/>
                        <line x1="2.6" y1="17.5" x2="4.4" y2="17.5"/>
                        <line x1="2.6" y1="19" x2="4.4" y2="19"/>
                        <line x1="19.6" y1="15" x2="21.4" y2="15"/>
                        <line x1="19.6" y1="16.7" x2="21.4" y2="16.7"/>
                        <line x1="19.6" y1="18.4" x2="21.4" y2="18.4"/>
                        <line x1="19.6" y1="20.1" x2="21.4" y2="20.1"/>
                      </g>
                      <ellipse cx="9.8" cy="10" rx="4.2" ry="3.4" fill="white"/>
                      <ellipse cx="14.2" cy="8.2" rx="5.2" ry="4.2" fill="white"/>
                      <rect x="6.8" y="10.4" width="10.8" height="3.6" rx="1.8" fill="white"/>
                    </svg>
                  )}
                </div>

                <div class="p-8">
                  <div class="flex items-center gap-2 mb-4">
                    <span class={`px-3 py-1 rounded-full text-xs font-semibold ${theme.badge}`}>{post.category}</span>
                    <span class="text-gray-400 text-sm">• {post.readTime} read</span>
                  </div>
                  <h3 class="text-2xl font-bold text-gray-900 mb-3 leading-snug group-hover:text-primary transition-colors">
                    {post.title}
                  </h3>
                  <p class="text-gray-500 leading-relaxed">{post.description}</p>

                  <div class="flex items-center justify-between mt-6 pt-5 border-t border-gray-100">
                    <div class="flex items-center gap-2">
                      <span class="w-7 h-7 rounded-full bg-primary/10 flex items-center justify-center">
                        <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                        </svg>
                      </span>
                      <span class="text-sm text-gray-600 font-medium">{post.author}</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-sm text-gray-400">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                      </svg>
                      {formatLong(post.date)}
                    </div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- All Posts -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-3 h-3 rounded-full bg-primary/20 flex items-center justify-center">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              </span>
              <span class="text-primary text-xs font-bold tracking-wider uppercase">Stay Updated</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-montserrat font-extrabold text-gray-900 mb-2">
              Latest Articles
            </h2>
            <p class="text-gray-500">Fresh perspectives on technology, development, and security.</p>
          </div>
          <a href="/blog" class="inline-flex items-center gap-2 px-5 py-2.5 border border-primary/30 text-primary rounded-full font-semibold text-sm hover:bg-primary hover:text-white transition-colors duration-300 flex-shrink-0 self-start md:self-auto">
            Browse all
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {regularPosts.map(post => {
            const theme = regularTheme[post.category];
            return (
              <a href={`/blog/${post.slug}`} class="group flex gap-4 bg-white border border-gray-100 rounded-2xl p-5 hover:shadow-lg transition-all duration-300">
                <div class={`flex-shrink-0 w-20 sm:w-24 rounded-xl bg-gradient-to-br ${theme.tile} flex items-center justify-center`}>
                  {post.category === 'Web Development' && (
                    <svg class={`w-8 h-8 ${theme.icon}`} fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M2 4.5A1.5 1.5 0 013.5 3h13A1.5 1.5 0 0118 4.5v8a1.5 1.5 0 01-1.5 1.5h-13A1.5 1.5 0 012 12.5v-8zM1 16a1 1 0 011-1h16a1 1 0 011 1 1 1 0 01-1 1H2a1 1 0 01-1-1z" clip-rule="evenodd"/>
                    </svg>
                  )}
                  {post.category === 'Salesforce' && (
                    <svg class={`w-8 h-8 ${theme.icon}`} fill="currentColor" viewBox="0 0 20 20">
                      <ellipse cx="8" cy="12" rx="4" ry="3.2"/>
                      <ellipse cx="12.5" cy="10.5" rx="4.5" ry="3.6"/>
                      <rect x="6" y="12" width="10" height="3" rx="1.5"/>
                    </svg>
                  )}
                  {post.category === 'Cybersecurity' && (
                    <svg class={`w-8 h-8 ${theme.icon}`} fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 1a4 4 0 00-4 4v2a2 2 0 00-2 2v6a2 2 0 002 2h8a2 2 0 002-2V9a2 2 0 00-2-2V5a4 4 0 00-4-4zm2 6V5a2 2 0 10-4 0v2h4z" clip-rule="evenodd"/>
                    </svg>
                  )}
                  {post.category === 'UI/UX Design' && (
                    <svg class={`w-8 h-8 ${theme.icon}`} viewBox="0 0 20 20">
                      <path fill="currentColor" d="M10 2a8 8 0 000 16c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.2 0-.8.7-1.5 1.5-1.5H14a4 4 0 004-4c0-3.3-3.6-6-8-6z"/>
                      <circle cx="6.5" cy="9" r="1.1" fill="#F59E0B"/>
                      <circle cx="9" cy="6" r="1.1" fill="#EF4444"/>
                      <circle cx="13" cy="6.5" r="1.1" fill="#3B82F6"/>
                      <circle cx="14.5" cy="10" r="1.1" fill="#10B981"/>
                    </svg>
                  )}
                </div>
                <div class="min-w-0 flex-1 flex flex-col">
                  <div class="flex items-center gap-2 mb-2">
                    <span class={`px-2.5 py-1 rounded-full text-xs font-semibold ${theme.badge}`}>{post.category}</span>
                    <span class="text-gray-400 text-xs">• {post.readTime}</span>
                  </div>
                  <h3 class="text-base font-bold text-gray-900 mb-1.5 leading-snug group-hover:text-primary transition-colors line-clamp-2">
                    {post.title}
                  </h3>
                  <p class="text-gray-500 text-sm mb-3 line-clamp-2">{post.description}</p>
                  <div class="mt-auto flex items-center justify-between pt-3 border-t border-gray-100 text-xs text-gray-500">
                    <div class="flex items-center gap-1.5">
                      <span class="w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                        <svg class="w-3 h-3 text-primary" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                        </svg>
                      </span>
                      <span>{post.author}</span>
                    </div>
                    <span>{formatShort(post.date)}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
