---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const caseStudies = [
  {
    slug: 'healthfirst-ai-document-processing',
    client: 'HealthFirst Insurance',
    title: 'AI-Powered Document Processing',
    description: 'Reduced claim processing time by 85% with intelligent document automation',
    industry: 'Healthcare',
    services: ['Generative AI', 'Cloud Migration'],
    results: [
      { metric: 'Processing Time', value: '-85%' },
      { metric: 'Cost Savings', value: '$2M' }
    ],
    featured: true
  },
  {
    slug: 'retailmax-cloud-migration',
    client: 'RetailMax',
    title: 'Enterprise Cloud Migration',
    description: 'Migrated 500+ VMs to AWS with zero downtime and 45% cost reduction',
    industry: 'Retail',
    services: ['Cloud Migration', 'DevOps'],
    results: [
      { metric: 'Cost Reduction', value: '45%' },
      { metric: 'Downtime', value: 'Zero' }
    ],
    featured: true
  },
  {
    slug: 'financecore-database-security',
    client: 'FinanceCore Bank',
    title: 'Database Security & Compliance',
    description: 'Achieved PCI-DSS certification with comprehensive database security overhaul',
    industry: 'Financial Services',
    services: ['Database Security', 'Cybersecurity'],
    results: [
      { metric: 'Compliance', value: '100%' },
      { metric: 'Data Secured', value: '500TB' }
    ],
    featured: false
  },
  {
    slug: 'techflow-saas-redesign',
    client: 'TechFlow SaaS',
    title: 'UI/UX Redesign & Development',
    description: 'Complete product redesign resulting in 65% increase in trial signups',
    industry: 'Technology',
    services: ['UI/UX Design', 'Web Development'],
    results: [
      { metric: 'Signups', value: '+65%' },
      { metric: 'Churn', value: '-40%' }
    ],
    featured: false
  },
  {
    slug: 'globaltech-salesforce-implementation',
    client: 'GlobalTech Industries',
    title: 'Salesforce Implementation',
    description: 'End-to-end Salesforce implementation with custom integrations and training',
    industry: 'Manufacturing',
    services: ['Salesforce Solutions', 'Integration'],
    results: [
      { metric: 'Productivity', value: '+40%' },
      { metric: 'ROI', value: '300%' }
    ],
    featured: false
  },
  {
    slug: 'mediahub-wordpress-enterprise',
    client: 'MediaHub Publishing',
    title: 'Enterprise WordPress Platform',
    description: 'Built scalable multisite network handling 10M monthly visitors across 50+ properties',
    industry: 'Media',
    services: ['WordPress Development', 'Cloud Migration'],
    results: [
      { metric: 'Visitors/Mo', value: '10M' },
      { metric: 'Sites', value: '50+' }
    ],
    featured: false
  }
];

const featuredStudies = caseStudies.filter(c => c.featured);
const otherStudies = caseStudies.filter(c => !c.featured);

const featuredTheme: Record<string, { badge: string; accent: string; stat: string; tile: string; ring: string }> = {
  Healthcare: {
    badge: 'bg-secondary/20 text-secondary',
    accent: 'text-secondary',
    stat: 'text-secondary',
    tile: 'from-secondary to-primary',
    ring: 'hover:border-secondary/30',
  },
  Retail: {
    badge: 'bg-accent/20 text-accent',
    accent: 'text-accent',
    stat: 'text-accent',
    tile: 'from-accent to-teal-800',
    ring: 'hover:border-accent/30',
  },
};

const otherTheme: Record<string, { badge: string; iconBg: string; iconColor: string; stat: string }> = {
  'Financial Services': { badge: 'bg-amber-100 text-amber-700', iconBg: 'bg-amber-100', iconColor: 'text-amber-600', stat: 'text-blue-600' },
  Technology: { badge: 'bg-sky-100 text-sky-700', iconBg: 'bg-sky-100', iconColor: 'text-sky-600', stat: 'text-blue-600' },
  Manufacturing: { badge: 'bg-rose-100 text-rose-700', iconBg: 'bg-rose-100', iconColor: 'text-rose-600', stat: 'text-rose-600' },
  Media: { badge: 'bg-purple-100 text-purple-700', iconBg: 'bg-purple-100', iconColor: 'text-purple-600', stat: 'text-secondary' },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://vireonixtech.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Case Studies"
    }
  ]
};
---

<Layout
  title="Case Studies | Client Success Stories | Vireonix Technologies"
  description="Explore how Vireonix Technologies has helped businesses achieve digital transformation. Real results from web development, cloud migration, AI, and Salesforce projects."
>
  <Header />
  <main>
    <!-- Featured Case Studies -->
    <section class="pt-32 pb-20 bg-gradient-to-br from-indigo-50 via-white to-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-10">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span>/</span>
          <span class="text-gray-700">Case Studies</span>
        </nav>

        <!-- Section Header -->
        <div class="text-center mb-16">
          <span class="inline-block px-4 py-1.5 bg-primary/10 text-primary rounded-full text-xs font-bold tracking-wider uppercase mb-5">
            Our Work
          </span>
          <h1 class="text-4xl md:text-5xl font-montserrat font-extrabold text-gray-900 mb-4">
            Featured Projects
          </h1>
          <p class="text-lg text-gray-500 max-w-2xl mx-auto">
            Innovative solutions that drive real business impact and deliver measurable results.
          </p>
          <div class="flex items-center justify-center gap-1.5 mt-6">
            <span class="w-12 h-0.5 bg-gradient-to-r from-primary to-accent rounded-full"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          </div>
        </div>

        <!-- Featured Cards -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {featuredStudies.map(study => {
            const theme = featuredTheme[study.industry];
            return (
              <a
                href={`/case-studies/${study.slug}`}
                class={`group relative block bg-gradient-to-br from-gray-900 to-dark rounded-3xl p-8 border border-white/5 ${theme.ring} hover:shadow-2xl transition-all duration-300`}
              >
                <!-- Arrow button -->
                <div class="absolute top-8 right-8 z-10 w-10 h-10 rounded-full bg-white/5 border border-white/15 flex items-center justify-center text-white group-hover:bg-white group-hover:text-dark transition-colors duration-300">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </div>

                <!-- Illustration tile -->
                <div class={`relative h-56 rounded-2xl bg-gradient-to-br ${theme.tile} mb-8 flex items-center justify-center overflow-hidden`}>
                  <div class="absolute -top-6 -left-6 w-28 h-28 bg-white/10 rounded-full blur-xl"></div>
                  <div class="absolute bottom-0 right-8 w-20 h-20 bg-black/10 rounded-full blur-xl"></div>
                  {study.industry === 'Healthcare' ? (
                    <svg class="w-28 h-28 drop-shadow-xl" viewBox="0 0 24 24" fill="none">
                      <path d="M6 4.5c0-.83.67-1.5 1.5-1.5h7l4 4v13c0 .83-.67 1.5-1.5 1.5h-9.5A1.5 1.5 0 0 1 6 20V4.5z" fill="white" fill-opacity="0.97"/>
                      <path d="M14.5 3v3.5A1.5 1.5 0 0 0 16 8h3" fill="white" fill-opacity="0.7"/>
                      <path d="M9 12h5M9 15h4" stroke="#6D28D9" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.5"/>
                      <path d="M9.5 9.2h3M11 7.7v3" stroke="#EF4444" stroke-width="1.6" stroke-linecap="round"/>
                      <path d="M14 15.2a3 3 0 0 1 4.5 0v1.8c0 2.1-1.5 3.3-4.5 4.3-3-1-4.5-2.2-4.5-4.3v-1.8a3 3 0 0 1 4.5 0z" fill="#06B6D4"/>
                      <path d="M12.6 17.7l1 1 1.9-2" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  ) : (
                    <svg class="w-28 h-28 drop-shadow-xl" viewBox="0 0 24 24" fill="none">
                      <ellipse cx="16" cy="6" rx="4.5" ry="3" fill="white" fill-opacity="0.85"/>
                      <ellipse cx="19.5" cy="7.5" rx="3" ry="2.2" fill="white" fill-opacity="0.7"/>
                      <rect x="6" y="16" width="3" height="3" rx="0.6" fill="white" fill-opacity="0.35"/>
                      <rect x="19" y="13" width="2.4" height="2.4" rx="0.5" fill="white" fill-opacity="0.35"/>
                      <g transform="translate(2.5,2) scale(1.05)" fill="white">
                        <path d="M3 1a1 1 0 000 2h.22l.305 1.222a1 1 0 00.01.042l1.358 5.43-.893.892C3.74 10.846 4.632 13 6.414 13H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 2H4.28l-.31-1.243A1 1 0 003 1H1z"/>
                        <path d="M16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
                      </g>
                    </svg>
                  )}
                </div>

                <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold mb-4 ${theme.badge}`}>
                  {study.industry}
                </span>
                <h3 class="text-2xl font-bold text-white mb-1">{study.client}</h3>
                <p class={`font-semibold mb-3 ${theme.accent}`}>{study.title}</p>
                <p class="text-white/60 leading-relaxed">{study.description}</p>

                <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-white/10">
                  {study.results.map(result => (
                    <div>
                      <div class={`text-3xl font-bold ${theme.stat}`}>{result.value}</div>
                      <div class="text-white/50 text-sm mt-1">{result.metric}</div>
                    </div>
                  ))}
                </div>

                <div class="flex flex-wrap gap-2 mt-6 pt-6 border-t border-white/10">
                  {study.services.map(service => (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/5 border border-white/10 text-white/70 text-xs font-medium rounded-full">
                      <span class={`w-1.5 h-1.5 rounded-full ${theme.stat.replace('text-', 'bg-')}`}></span>
                      {service}
                    </span>
                  ))}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- More Success Stories -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-14">
          <span class="inline-block px-4 py-1.5 bg-primary/10 text-primary rounded-full text-xs font-bold tracking-wider uppercase mb-5">
            Success Stories
          </span>
          <h2 class="text-3xl md:text-4xl font-montserrat font-extrabold text-gray-900">
            More Success Stories
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {otherStudies.map(study => {
            const theme = otherTheme[study.industry];
            return (
              <a
                href={`/case-studies/${study.slug}`}
                class="group block bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
              >
                <div class={`w-16 h-16 rounded-full ${theme.iconBg} flex items-center justify-center mb-5`}>
                  {study.industry === 'Financial Services' && (
                    <svg class={`w-7 h-7 ${theme.iconColor}`} fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10 1.5l8.5 4.25v1.5H1.5v-1.5L10 1.5z"/>
                      <path d="M3 8.75h2v7H3v-7zm4 0h2v7H7v-7zm4 0h2v7h-2v-7zm4 0h2v7h-2v-7z"/>
                      <path d="M1.5 17h17v1.5h-17V17z"/>
                    </svg>
                  )}
                  {study.industry === 'Technology' && (
                    <svg class={`w-7 h-7 ${theme.iconColor}`} fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M2 4.5A1.5 1.5 0 013.5 3h13A1.5 1.5 0 0118 4.5v8a1.5 1.5 0 01-1.5 1.5h-13A1.5 1.5 0 012 12.5v-8zM1 16a1 1 0 011-1h16a1 1 0 011 1 1 1 0 01-1 1H2a1 1 0 01-1-1z" clip-rule="evenodd"/>
                    </svg>
                  )}
                  {study.industry === 'Manufacturing' && (
                    <svg class={`w-7 h-7 ${theme.iconColor}`} fill="currentColor" viewBox="0 0 20 20">
                      <rect x="2" y="11" width="16" height="7" rx="0.5"/>
                      <rect x="4.3" y="5" width="2.2" height="6" rx="0.4"/>
                      <rect x="8.9" y="7.5" width="2.2" height="3.5" rx="0.4"/>
                      <rect x="13.5" y="4" width="2.2" height="7" rx="0.4"/>
                      <circle cx="5.4" cy="3.2" r="1" opacity="0.55"/>
                      <circle cx="14.6" cy="2.2" r="1" opacity="0.55"/>
                    </svg>
                  )}
                  {study.industry === 'Media' && (
                    <svg class={`w-7 h-7 ${theme.iconColor}`} fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M4 4a1 1 0 00-1 1v10a2 2 0 002 2h10a2 2 0 002-2V8a1 1 0 00-1-1h-1V5a1 1 0 00-1-1H4zm10 4H6v8h8V8zM4 6h6v2H4V6zm0 4h2v6H4v-6z" clip-rule="evenodd"/>
                    </svg>
                  )}
                </div>

                <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold mb-3 ${theme.badge}`}>
                  {study.industry}
                </span>
                <h3 class="text-lg font-bold text-gray-900 mb-1 group-hover:text-primary transition-colors">
                  {study.client}
                </h3>
                <p class="text-gray-500 text-sm mb-5">{study.title}</p>

                <div class="grid grid-cols-2 gap-3 pt-5 border-t border-gray-100">
                  {study.results.slice(0, 2).map(result => (
                    <div>
                      <div class={`text-xl font-bold ${theme.stat}`}>{result.value}</div>
                      <div class="text-gray-400 text-xs mt-0.5">{result.metric}</div>
                    </div>
                  ))}
                </div>
              </a>
            );
          })}
        </div>

        <!-- CTA Bar -->
        <div class="mt-16 flex flex-col md:flex-row items-center justify-between gap-6 bg-white border border-primary/20 rounded-3xl p-8 md:p-10">
          <div class="flex items-center gap-5 text-center md:text-left">
            <div class="hidden sm:flex w-14 h-14 rounded-2xl bg-gradient-to-br from-primary to-secondary items-center justify-center flex-shrink-0">
              <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-1">Have a project in mind?</h3>
              <p class="text-gray-500">Let's build something amazing together. Share your idea and we'll turn it into reality.</p>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0 w-full md:w-auto">
            <a href="/#contact" class="bg-button-gradient text-white px-6 py-3 rounded-xl font-semibold hover:shadow-lg transition-all duration-300 inline-flex items-center justify-center gap-2 whitespace-nowrap">
              Discuss Your Project
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
            <a href="/case-studies" class="border border-gray-200 text-gray-700 px-6 py-3 rounded-xl font-semibold hover:bg-gray-50 transition-all duration-300 inline-flex items-center justify-center gap-2 whitespace-nowrap">
              View All Projects
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
