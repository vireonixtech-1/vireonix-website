---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About Vireonix Technologies | Enterprise IT Excellence"
  description="Learn about Vireonix Technologies LLC, a Georgia-based technology consulting firm. ISO 27001 & SOC 2 certified, serving enterprise clients across the globe."
>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center bg-hero-gradient overflow-hidden pt-24">
      <!-- Animated Background -->
      <div class="absolute inset-0">
        <div class="particles-container"></div>
        <div class="absolute top-20 right-20 w-96 h-96 bg-accent/20 rounded-full blur-3xl animate-float"></div>
        <div class="absolute bottom-20 left-20 w-80 h-80 bg-secondary/20 rounded-full blur-3xl animate-float" style="animation-delay: -2s;"></div>
      </div>
      
      <!-- Glassmorphism Overlay -->
      <div class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-black/20 backdrop-blur-xs"></div>
      
      <!-- Content -->
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 text-center">
        <div class="max-w-4xl mx-auto">
          <!-- Badge -->
          <div class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white/90 text-sm font-medium mb-8 animate-fade-up">
            <span class="w-2 h-2 bg-accent rounded-full mr-2 animate-pulse"></span>
            Enterprise Technology Excellence
          </div>
          
          <!-- Main Headline -->
          <h1 class="text-5xl md:text-6xl lg:text-6xl font-montserrat font-extrabold text-white mb-6 leading-tight animate-fade-up" style="animation-delay: 0.2s;">
            About Vireonix<br>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-secondary">
              Technologies LLC
            </span>
          </h1>
          
          <!-- Subheadline -->
          <p class="text-xl md:text-2xl text-white/80 mb-12 max-w-3xl mx-auto leading-relaxed animate-fade-up" style="animation-delay: 0.4s;">
            Pioneering technology solutions with deep innovation,
            expertise, and unwavering commitment to client success.
          </p>
        </div>
      </div>
    </section>

    <!-- Company Story Section -->
    <section class="py-20 bg-white relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <!-- Content -->
          <div>
            <h2 class="text-4xl md:text-5xl font-montserrat font-extrabold text-gray-900 mb-6">
              Our Story
            </h2>
            <div class="space-y-6 text-lg text-gray-700 leading-relaxed">
              <p>
                Vireonix Technologies LLC began as a vision to bridge the gap between
                cutting-edge technology and practical business solutions. What started as a small team
                of passionate technologists has evolved into a leading technology services company
                trusted by enterprises worldwide.
              </p>
              <p>
                We've witnessed and actively participated in the digital
                transformation revolution. From the early days of web development to today's AI-powered
                solutions, we've consistently stayed ahead of the curve, helping our clients navigate
                technological changes and leverage them for competitive advantage.
              </p>
              <p>
                Our journey has been marked by continuous innovation, strategic partnerships, and an
                unwavering commitment to delivering exceptional value. Today, we're proud to serve
                clients across the globe, maintaining our founding principles while embracing
                the future of technology.
              </p>
            </div>
          </div>
          
          <!-- Visual Element -->
          <div class="relative">
            <div class="bg-gradient-to-br from-primary/10 to-accent/10 rounded-3xl p-12 text-center">
              <div class="text-6xl mb-6">🚀</div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Innovation-Driven</h3>
              <p class="text-gray-600 mb-6">
                A track record of technological evolution, adaptation, and client success stories.
              </p>
              <div class="grid grid-cols-2 gap-6 text-center">
                <div>
                  <div class="text-lg font-bold text-primary">Enterprise Clients</div>
                  <div class="text-sm text-gray-600">Across Industries</div>
                </div>
                <div>
                  <div class="text-lg font-bold text-accent">Global Reach</div>
                  <div class="text-sm text-gray-600">Worldwide Delivery</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission, Vision, Values -->
    <section class="py-20 bg-gray-50 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-montserrat font-extrabold text-gray-900 mb-4">
            Our Foundation
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            The principles that guide everything we do
          </p>
        </div>
        
        <!-- Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Mission -->
          <div class="bg-white rounded-3xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="w-16 h-16 bg-gradient-to-br from-primary to-accent rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Our Mission</h3>
            <p class="text-gray-600 leading-relaxed">
              To empower businesses through innovative technology solutions that drive growth, 
              enhance efficiency, and create lasting competitive advantages in an ever-evolving 
              digital landscape.
            </p>
          </div>
          
          <!-- Vision -->
          <div class="bg-white rounded-3xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="w-16 h-16 bg-gradient-to-br from-accent to-secondary rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Our Vision</h3>
            <p class="text-gray-600 leading-relaxed">
              To be the global leader in technology consulting and development, recognized for 
              our innovation, expertise, and unwavering commitment to client success across 
              all industries and markets.
            </p>
          </div>
          
          <!-- Values -->
          <div class="bg-white rounded-3xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="w-16 h-16 bg-gradient-to-br from-secondary to-primary rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Our Values</h3>
            <p class="text-gray-600 leading-relaxed">
              Excellence, integrity, innovation, and client-centricity form the cornerstone of 
              our culture. We believe in building lasting partnerships through trust, 
              transparency, and exceptional service delivery.
            </p>
          </div>
        </div>
      </div>
    </section>
  
    <!-- Leadership Schema (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Vireonix Technologies LLC",
      "url": "https://vireonixtech.com",
      "founder": {
        "@type": "Person",
        "name": "Rajesh Sharma",
        "jobTitle": "Founder & Chief Executive Officer",
        "description": "Founder of Vireonix Technologies with extensive experience in enterprise technology strategy and digital transformation.",
        "worksFor": {
          "@type": "Organization",
          "name": "Vireonix Technologies LLC"
        }
      },
      "employee": [
        {
          "@type": "Person",
          "name": "Rajesh Sharma",
          "jobTitle": "Founder & Chief Executive Officer",
          "description": "Founder of Vireonix Technologies with a vision to deliver enterprise-grade technology solutions. Led digital transformation initiatives for Fortune 500 companies."
        },
        {
          "@type": "Person",
          "name": "Priya Patel",
          "jobTitle": "Chief Technology Officer",
          "description": "22 years of engineering leadership. Previously at Microsoft and AWS. Expert in AI/ML, cloud architecture, and cybersecurity. Holds patents in distributed systems."
        },
        {
          "@type": "Person",
          "name": "David Chen",
          "jobTitle": "Chief Operating Officer",
          "description": "18 years in operations leadership at Accenture and Deloitte. Oversees global operations with a strong focus on client satisfaction and service excellence."
        },
        {
          "@type": "Person",
          "name": "Arun Kumar",
          "jobTitle": "VP of Engineering",
          "description": "15+ years leading engineering teams. Former Tech Lead at Google. Expert in scalable systems and DevOps."
        },
        {
          "@type": "Person",
          "name": "Jennifer Martinez",
          "jobTitle": "VP of Sales",
          "description": "20+ years in enterprise sales. Built partnerships with Fortune 500 clients across healthcare and finance sectors."
        },
        {
          "@type": "Person",
          "name": "Sarah Williams",
          "jobTitle": "VP of Client Success",
          "description": "12+ years ensuring project success and building long-term client partnerships."
        },
        {
          "@type": "Person",
          "name": "Dr. Michael Roberts",
          "jobTitle": "Director of AI & Innovation",
          "description": "PhD in Machine Learning from Stanford. Published researcher leading generative AI initiatives."
        }
      ]
    }
    </script>

    <!-- Company Culture -->
    <section class="py-20 bg-dark relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-montserrat font-extrabold text-white mb-4">
            Our Culture
          </h2>
          <p class="text-xl text-gray-300 max-w-3xl mx-auto">
            Building a workplace where innovation thrives and people grow
          </p>
        </div>
        
        <!-- Culture Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Innovation -->
          <div class="text-center">
            <div class="w-16 h-16 bg-primary/20 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-primary" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Innovation First</h3>
            <p class="text-gray-300 text-sm">
              Encouraging creative thinking and breakthrough solutions
            </p>
          </div>
          
          <!-- Collaboration -->
          <div class="text-center">
            <div class="w-16 h-16 bg-accent/20 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Team Collaboration</h3>
            <p class="text-gray-300 text-sm">
              Working together to achieve extraordinary results
            </p>
          </div>
          
          <!-- Growth -->
          <div class="text-center">
            <div class="w-16 h-16 bg-secondary/20 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Continuous Growth</h3>
            <p class="text-gray-300 text-sm">
              Investing in learning and professional development
            </p>
          </div>
          
          <!-- Excellence -->
          <div class="text-center">
            <div class="w-16 h-16 bg-green-500/20 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Excellence</h3>
            <p class="text-gray-300 text-sm">
              Maintaining the highest standards in everything we do
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Certifications & Awards -->
    <section class="py-20 bg-white relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-montserrat font-extrabold text-gray-900 mb-4">
            Certifications & Recognition
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Industry recognition and certifications that validate our expertise
          </p>
        </div>
        
        <!-- Certifications Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- ISO 27001 -->
          <div class="text-center p-6 bg-gray-50 rounded-2xl hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">ISO 27001</h3>
            <p class="text-sm text-gray-600">Information Security Management</p>
          </div>
          
          <!-- SOC 2 -->
          <div class="text-center p-6 bg-gray-50 rounded-2xl hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-green-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">SOC 2 Type II</h3>
            <p class="text-sm text-gray-600">Security & Availability</p>
          </div>
          
          <!-- AWS Partner -->
          <div class="text-center p-6 bg-gray-50 rounded-2xl hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-orange-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M5.5 16a3.5 3.5 0 01-.369-6.98 4 4 0 117.753-1.977A4.5 4.5 0 1113.5 16h-8z" />
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">AWS Partner</h3>
            <p class="text-sm text-gray-600">Advanced Consulting Partner</p>
          </div>
          
          <!-- Industry Awards -->
          <div class="text-center p-6 bg-gray-50 rounded-2xl hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-yellow-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Award-Winning</h3>
            <p class="text-sm text-gray-600">Industry Recognition</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-20 bg-gradient-to-br from-primary to-accent relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
        <h2 class="text-4xl md:text-5xl font-montserrat font-extrabold text-white mb-6">
          Ready to Work Together?
        </h2>
        <p class="text-xl text-white/90 mb-12 max-w-3xl mx-auto">
          Let's discuss how our expertise can help transform your business
          with innovative technology solutions.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <a href="#contact" class="bg-white text-primary px-8 py-4 rounded-full font-semibold text-lg hover:shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2">
            Start Your Project
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="/portfolio" class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-8 py-4 rounded-full font-semibold text-lg hover:bg-white/20 transition-all duration-300">
            View Our Work
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .particles-container {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(2px 2px at 20px 30px, rgba(6, 182, 212, 0.3), transparent),
      radial-gradient(2px 2px at 40px 70px, rgba(147, 51, 234, 0.3), transparent),
      radial-gradient(1px 1px at 90px 40px, rgba(6, 182, 212, 0.5), transparent),
      radial-gradient(1px 1px at 130px 80px, rgba(147, 51, 234, 0.5), transparent);
    background-repeat: repeat;
    background-size: 150px 100px;
    animation: particles 20s linear infinite;
  }
  
  @keyframes particles {
    0% { background-position: 0 0, 0 0, 0 0, 0 0; }
    100% { background-position: 150px 100px, -150px 100px, 150px -100px, -150px -100px; }
  }
</style>