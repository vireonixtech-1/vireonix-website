---
---

<section id="portfolio" class="py-24 bg-dark relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal-up">
      <span class="inline-block px-4 py-2 bg-white/10 text-accent rounded-full text-sm font-semibold mb-4">
        Our Work
      </span>
      <h2 class="text-4xl md:text-5xl font-montserrat font-extrabold text-white mb-4">
        Featured Projects
      </h2>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        Discover how we've transformed businesses across industries with innovative technology solutions
      </p>
    </div>

    <!-- Portfolio Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 stagger-children">
      <!-- Project 1: Fitness App -->
      <div class="stagger-item group bg-card-gradient backdrop-blur-md border border-white/10 rounded-3xl p-8 hover:border-primary/40 hover:shadow-2xl transition-all duration-500">
        <div class="flex gap-6">
          <div class="flex-shrink-0 w-28 h-28 md:w-32 md:h-32 rounded-2xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-lg">
            <svg class="w-14 h-14 md:w-16 md:h-16 text-white" fill="none" viewBox="0 0 24 24">
              <rect x="7" y="6" width="10" height="12" rx="3" fill="currentColor" fill-opacity="0.25"/>
              <rect x="8.5" y="7.5" width="7" height="9" rx="1.5" fill="currentColor" fill-opacity="0.9"/>
              <path d="M9 4h6v2H9zM9 18h6v2H9z" fill="currentColor"/>
              <path d="M9.5 12.5l1.4-1.8 1.1 1.4 1.6-2" stroke="#EF4444" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-primary/20 text-primary text-xs font-semibold rounded-full">Mobile App</span>
              <span class="px-3 py-1 bg-accent/20 text-accent text-xs font-semibold rounded-full">React Native</span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-accent transition-colors">FitTrack Pro</h3>
            <p class="text-gray-300 leading-relaxed">A comprehensive fitness tracking application with AI-powered workout recommendations, social features, and real-time analytics.</p>
          </div>
        </div>

        <div class="mt-6 pt-6 border-t border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-secondary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="text-sm">
              <div class="text-gray-300">Healthcare & Fitness</div>
              <div class="flex items-center gap-1 mt-1 text-gray-400">
                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span>4.8 App Store Rating</span>
              </div>
            </div>
          </div>
          <button aria-label="View FitTrack Pro" class="w-12 h-12 rounded-full border-2 border-primary text-primary flex items-center justify-center flex-shrink-0 hover:bg-primary hover:text-white transition-colors duration-300">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Project 2: Banking Dashboard -->
      <div class="stagger-item group bg-card-gradient backdrop-blur-md border border-white/10 rounded-3xl p-8 hover:border-accent/40 hover:shadow-2xl transition-all duration-500">
        <div class="flex gap-6">
          <div class="flex-shrink-0 w-28 h-28 md:w-32 md:h-32 rounded-2xl bg-gradient-to-br from-accent to-teal-700 flex items-center justify-center shadow-lg relative">
            <svg class="w-14 h-14 md:w-16 md:h-16 text-white" fill="none" viewBox="0 0 24 24">
              <path d="M4 10l8-5 8 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="currentColor" fill-opacity="0.15"/>
              <rect x="5" y="10" width="14" height="8" fill="currentColor" fill-opacity="0.9"/>
              <rect x="3" y="18" width="18" height="2" rx="0.5" fill="currentColor"/>
              <rect x="7" y="11.5" width="2" height="5" fill="#0F172A" fill-opacity="0.5"/>
              <rect x="11" y="11.5" width="2" height="5" fill="#0F172A" fill-opacity="0.5"/>
              <rect x="15" y="11.5" width="2" height="5" fill="#0F172A" fill-opacity="0.5"/>
            </svg>
            <div class="absolute -top-2 -right-2 w-7 h-7 rounded-full bg-yellow-400 flex items-center justify-center text-dark text-xs font-bold shadow">$</div>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-accent/20 text-accent text-xs font-semibold rounded-full">Web App</span>
              <span class="px-3 py-1 bg-secondary/20 text-secondary text-xs font-semibold rounded-full">React</span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-accent transition-colors">SecureBank Portal</h3>
            <p class="text-gray-300 leading-relaxed">Enterprise banking dashboard with advanced security features, real-time transactions, and comprehensive financial analytics.</p>
          </div>
        </div>

        <div class="mt-6 pt-6 border-t border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-accent/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </div>
            <div class="text-sm">
              <div class="text-gray-300">Financial Services</div>
              <div class="flex items-center gap-1 mt-1 text-gray-400">
                <svg class="w-4 h-4 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>SOC 2 Compliant</span>
              </div>
            </div>
          </div>
          <button aria-label="View SecureBank Portal" class="w-12 h-12 rounded-full border-2 border-accent text-accent flex items-center justify-center flex-shrink-0 hover:bg-accent hover:text-white transition-colors duration-300">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Project 3: Healthcare Portal -->
      <div class="stagger-item group bg-card-gradient backdrop-blur-md border border-white/10 rounded-3xl p-8 hover:border-secondary/40 hover:shadow-2xl transition-all duration-500">
        <div class="flex gap-6">
          <div class="flex-shrink-0 w-28 h-28 md:w-32 md:h-32 rounded-2xl bg-gradient-to-br from-secondary to-primary flex items-center justify-center shadow-lg">
            <svg class="w-14 h-14 md:w-16 md:h-16" viewBox="0 0 24 24" fill="none">
              <rect x="5" y="4" width="14" height="17" rx="2" fill="white" fill-opacity="0.95"/>
              <rect x="8.5" y="2.5" width="7" height="3" rx="1" fill="white"/>
              <path d="M10.5 9h3M12 7.5v3" stroke="#EF4444" stroke-width="1.4" stroke-linecap="round"/>
              <path d="M7.5 13h9M7.5 16h6" stroke="#4F46E5" stroke-width="1" stroke-linecap="round" stroke-opacity="0.6"/>
              <path d="M17 15.5a2.5 2.5 0 013 0v1.5c0 1.8-1.2 2.8-3 3.5-1.8-.7-3-1.7-3-3.5v-1.5a2.5 2.5 0 013 0z" fill="#06B6D4"/>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-secondary/20 text-secondary text-xs font-semibold rounded-full">Platform</span>
              <span class="px-3 py-1 bg-primary/20 text-primary text-xs font-semibold rounded-full">Angular</span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-accent transition-colors">MediCare Connect</h3>
            <p class="text-gray-300 leading-relaxed">Comprehensive healthcare management platform connecting patients, providers, and administrators in one secure ecosystem.</p>
          </div>
        </div>

        <div class="mt-6 pt-6 border-t border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-secondary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="text-sm">
              <div class="text-gray-300">Healthcare Technology</div>
              <div class="flex items-center gap-1 mt-1 text-gray-400">
                <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>HIPAA Compliant</span>
              </div>
            </div>
          </div>
          <button aria-label="View MediCare Connect" class="w-12 h-12 rounded-full border-2 border-secondary text-secondary flex items-center justify-center flex-shrink-0 hover:bg-secondary hover:text-white transition-colors duration-300">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Project 4: Travel Companion -->
      <div class="stagger-item group bg-card-gradient backdrop-blur-md border border-white/10 rounded-3xl p-8 hover:border-secondary/40 hover:shadow-2xl transition-all duration-500">
        <div class="flex gap-6">
          <div class="flex-shrink-0 w-28 h-28 md:w-32 md:h-32 rounded-2xl bg-gradient-to-br from-secondary to-primary flex items-center justify-center shadow-lg overflow-hidden relative">
            <svg class="absolute top-4 left-3 w-6 h-4 text-white/40" fill="currentColor" viewBox="0 0 24 16"><ellipse cx="12" cy="8" rx="12" ry="6"/></svg>
            <svg class="absolute bottom-5 right-3 w-5 h-3 text-white/30" fill="currentColor" viewBox="0 0 24 16"><ellipse cx="12" cy="8" rx="12" ry="6"/></svg>
            <svg class="w-14 h-14 md:w-16 md:h-16 text-white -rotate-45" fill="currentColor" viewBox="0 0 24 24">
              <path d="M21 15l-6-4V5a2 2 0 00-4 0v6l-6 4v2l6-2v4l-2 1.5V21l3-1 3 1v-1.5L13 19v-4l6 2v-2z"/>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-primary/20 text-primary text-xs font-semibold rounded-full">Mobile</span>
              <span class="px-3 py-1 bg-secondary/20 text-secondary text-xs font-semibold rounded-full">Flutter</span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-accent transition-colors">WanderGuide AI</h3>
            <p class="text-gray-300 leading-relaxed">AI-powered travel companion app with smart itinerary planning, local recommendations, and real-time travel updates.</p>
          </div>
        </div>

        <div class="mt-6 pt-6 border-t border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-secondary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" />
                <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15a24.974 24.974 0 01-8-1.308z" />
              </svg>
            </div>
            <div class="text-sm">
              <div class="text-gray-300">Travel & Tourism</div>
              <div class="flex items-center gap-1 mt-1 text-gray-400">
                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span>4.9 User Rating</span>
              </div>
            </div>
          </div>
          <button aria-label="View WanderGuide AI" class="w-12 h-12 rounded-full border-2 border-secondary text-secondary flex items-center justify-center flex-shrink-0 hover:bg-secondary hover:text-white transition-colors duration-300">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>
    </div>
    
    <!-- CTA Section -->
    <div class="mt-16 text-center">
      <p class="text-lg text-gray-300 mb-8">Interested in seeing more of our work?</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact" class="bg-button-gradient text-white px-8 py-4 rounded-full font-semibold text-lg hover:shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2">
          Discuss Your Project
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/about" class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-8 py-4 rounded-full font-semibold text-lg hover:bg-white/20 transition-all duration-300">
          About Us
        </a>
      </div>
    </div>
  </div>
  
</section>